# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Consumed by scripts/gen-paddle-config.mjs (`npm run paddle:config`), which writes
# public/pricing/paddle-config.js and dist/pricing/paddle-config.js. The /pricing page
# reads its Paddle settings from there — nothing Paddle-specific is hard-coded in HTML.

# Which Paddle account to talk to. Must be exactly "sandbox" or "production".
# There is deliberately NO default: if this is unset, the config generator exits
# non-zero rather than guess, so the live site can never point at the wrong account.
PADDLE_ENV=production

# Client-side token: Paddle dashboard > Developer tools > Authentication >
# Client-side tokens. Prefixed live_ on production, test_ on sandbox — the generator
# rejects a token whose prefix contradicts PADDLE_ENV.
#
# This token is PUBLIC by design; it is served to every visitor's browser.
# The server-side API key (pdl_live_apikey_…) is NOT used anywhere on this site and
# must never be put here — the site is static, so there is nowhere private to keep it.
PADDLE_CLIENT_TOKEN=live_replace_me
